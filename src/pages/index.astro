---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { categories, industries } from "../content.config";
import { formatRecords, sizeOf, sizes } from "../lib";

const incidents = (await getCollection("incidents")).sort(
  (a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt) || a.id.localeCompare(b.id),
);

const months = Map.groupBy(incidents, (i) => i.data.publishedAt.slice(0, 7));
---

<Base>
  <form id="filters" role="search">
    <input type="search" name="q" placeholder="組織名・タイトルで検索" aria-label="キーワード" />
    <details>
      <summary>絞り込み<span id="active"></span></summary>
      <div class="panel">
        <label>種別
          <select name="category">
            <option value="">すべて</option>
            {categories.map((c) => <option>{c}</option>)}
          </select>
        </label>
        <label>業種
          <select name="industry">
            <option value="">すべて</option>
            {industries.map((c) => <option>{c}</option>)}
            <option>未分類</option>
          </select>
        </label>
        <label>規模
          <select name="size">
            <option value="">すべて</option>
            {sizes.map((s) => <option>{s}</option>)}
          </select>
        </label>
      </div>
    </details>
  </form>
  <p class="count" aria-live="polite"><span id="count" class="num">{incidents.length}</span> 件</p>

  {incidents.length === 0 && <p>まだ事案がありません。</p>}

  {
    [...months].map(([month, items]) => (
      <section class="month">
        <h2>
          <time datetime={month}>{month.replace("-", "年")}月</time>
        </h2>
        <ol>
          {items.map(({ id, data }) => (
            <li
              data-text={`${data.organization} ${data.title}`.toLowerCase()}
              data-category={data.category}
              data-industry={data.industry ?? "未分類"}
              data-size={sizeOf(data.records)}
            >
              <a class="card" href={`/incidents/${id}/`}>
                <time datetime={data.publishedAt}>{data.publishedAt.slice(5).replace("-", "/")}</time>
                <strong>{data.organization}</strong>
                <span class="title">{data.title}</span>
                <span class="meta">
                  {data.category} · {data.industry ?? "未分類"} · <span class="num">{formatRecords(data.records)}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("#filters")!;
  const count = document.querySelector("#count")!;
  const active = document.querySelector("#active")!;

  function apply() {
    const f = new FormData(form);
    const q = String(f.get("q")).trim().toLowerCase();
    let n = 0;
    for (const section of document.querySelectorAll<HTMLElement>(".month")) {
      let visible = 0;
      for (const li of section.querySelectorAll<HTMLElement>("li")) {
        const d = li.dataset;
        const show =
          (!q || d.text!.includes(q)) &&
          (!f.get("category") || d.category === f.get("category")) &&
          (!f.get("industry") || d.industry === f.get("industry")) &&
          (!f.get("size") || d.size === f.get("size"));
        li.hidden = !show;
        if (show) visible++;
      }
      section.hidden = visible === 0;
      n += visible;
    }
    count.textContent = String(n);
    const k = ["category", "industry", "size"].filter((name) => f.get(name)).length;
    active.textContent = k ? ` ${k}` : "";
  }

  form.addEventListener("input", apply);
  form.addEventListener("submit", (e) => e.preventDefault());
</script>

<style>
  #filters {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  #filters input,
  #filters summary,
  #filters select {
    font: inherit;
    color: var(--fg);
    padding: 0.35rem 0.9rem;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.6);
  }
  #filters input {
    flex: 1;
    min-width: 0;
  }
  #filters input:focus-visible,
  #filters select:focus-visible,
  #filters summary:focus-visible {
    outline: none;
    border-color: var(--accent);
  }
  details {
    position: relative;
  }
  summary {
    cursor: pointer;
    white-space: nowrap;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: " ▾";
    color: var(--muted);
  }
  details[open] summary {
    border-color: var(--accent);
  }
  #active {
    color: var(--accent);
    font-weight: 800;
  }
  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 2;
    display: grid;
    gap: 0.6rem;
    width: min(16rem, 80vw);
    padding: 1rem;
    border: 2px solid var(--fg);
    border-radius: 1rem;
    background: var(--card);
    box-shadow: 4px 4px 0 var(--fg);
  }
  .panel label {
    display: grid;
    gap: 0.2rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .panel select {
    border-radius: 0.6rem;
    font-weight: 400;
  }
  .count {
    margin: 0.4rem 0 0;
    text-align: right;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* タイムライン: 左の縦線に月ラベルと種別色の点を並べる */
  .month {
    position: relative;
    padding-left: 2rem;
  }
  .month::before {
    content: "";
    position: absolute;
    left: 0.6rem;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: 2px;
    background: repeating-linear-gradient(var(--accent) 0 10px, transparent 10px 16px);
    opacity: 0.35;
  }
  .month h2 {
    position: sticky;
    top: 0.5rem;
    z-index: 1;
    display: inline-block;
    margin: 2rem 0 0.5rem -2rem;
    padding: 0.2rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 1rem;
    box-shadow: 3px 3px 0 var(--fg);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    position: relative;
    padding: 0.5rem 0;
  }
  li::before {
    content: "";
    position: absolute;
    left: -1.85rem;
    top: 1.35rem;
    width: 1rem;
    height: 1rem;
    border: 3px solid var(--fg);
    border-radius: 50%;
    background: var(--c);
  }
  li[hidden],
  section[hidden] {
    display: none;
  }
  .card {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 1rem;
    border: 2px solid var(--fg);
    border-radius: 1rem;
    background: var(--card);
    box-shadow: 4px 4px 0 var(--c);
    color: var(--fg);
    text-decoration: none;
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .card:hover,
  .card:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--c);
  }
  .card time {
    font-weight: 800;
    color: var(--muted);
  }
  .card strong {
    font-size: 1.05rem;
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
